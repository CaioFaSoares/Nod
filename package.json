{
  "name": "bond",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc && vite build --base=./",
    "app:dev": "bun scripts/gen-config.ts dev && tinyjs dev",
    "app:build": "bun scripts/gen-config.ts build && tinyjs build",
    "test": "bun test test/",
    "typecheck": "tsc -p tsconfig.json && tsc -p backend/tsconfig.json && tsc -p host/tsconfig.json"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
