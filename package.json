{
  "name": "nod",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc && vite build --base=./",
    "test": "bun test test/",
    "typecheck": "bun scripts/typecheck.ts",
    "typecheck:app": "tsc -p tsconfig.json && tsc -p backend/tsconfig.json && tsc -p host/tsconfig.json",
    "eb:dev": "bun scripts/eb-dev.ts",
    "eb:build": "bun scripts/eb-build.ts",
    "eb:verify": "bun scripts/eb-postbuild.ts --verify-only",
    "validate": "bun scripts/validate.ts",
    "app:dev": "bun scripts/eb-dev.ts",
    "app:build": "bun scripts/eb-build.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "@types/bun": "1.4.3",
    "electrobun": "2.0.5"
  }
}
